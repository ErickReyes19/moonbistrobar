---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import moon from '../assets/img/moon-disc.png';
import { site } from '../data/site';
---

<section id="inicio" aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-night">
  <!-- Cielo estrellado del logo -->
  <!-- Capa 1 (fondo, la más lenta): el cielo estrellado del logo -->
  <div aria-hidden="true" class="absolute inset-x-0 -top-[10%] -z-20 h-[120%] bg-[url(/brand/stars.svg)] bg-cover bg-center opacity-90" data-hero-stars></div>

  <div class="wrap grid min-h-[100svh] grid-cols-1 content-center gap-8 pb-10 pt-24 sm:gap-10 sm:pb-16 sm:pt-28 lg:grid-cols-12 lg:gap-6 lg:pb-24 lg:pt-32">
    <!-- Capa 2 (plano medio): la luna real del salón. Móvil: arriba (tamaño contenido para que el hero quepa en una pantalla); escritorio: a la derecha, sangrando del borde. -->
    <div
      class="hero-moon pointer-events-none relative -mr-[14vw] ml-auto w-[min(56vw,24rem)] self-start sm:w-[min(70vw,26rem)]
             lg:absolute lg:right-[-7vw] lg:top-1/2 lg:-mr-0 lg:w-[min(82vh,56vw)] lg:-translate-y-1/2"
    >
      <div class="rounded-full shadow-[0_0_7rem_1.5rem_rgba(235,193,111,0.18)]" data-hero-moon>
        <Picture
          src={moon}
          alt="La luna retroiluminada con cráteres que preside el salón de Moon Bistro Bar"
          widths={[480, 720, 1000]}
          sizes="(min-width: 1024px) 56vw, 78vw"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          priority
          pictureAttributes={{ class: 'block' }}
          class="block aspect-square w-full rounded-full"
        />
      </div>
    </div>

    <!-- Capa 3 (contenido, velocidad normal): el texto nunca lleva parallax -->
    <div class="relative lg:col-span-7 xl:col-span-6">
      <h1 id="hero-title" class="text-display text-moon" data-hero-title>Fusión asiática bajo la&nbsp;luna</h1>
      <p class="mt-6 max-w-[34rem] text-lead text-champagne" data-hero-enter>
        Bistro y bar en Barrio Los Andes, San Pedro Sula. Dim sum, wok, mariscos y coctelería de autor bajo la luna
        más grande de Honduras.
      </p>

      <p class="mt-7 flex items-center gap-2.5 text-sm text-moon/85" data-open-status aria-live="polite" data-hero-enter>
        <span class="size-2 rounded-full bg-gold" data-dot aria-hidden="true"></span>
        <span data-text>Martes a domingo desde las 12:00 p. m.</span>
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" data-hero-enter>
        <a href={site.whatsapp.href} class="btn btn-primary" rel="noopener" target="_blank">
          <Icon name="whatsapp" />
          Reservar por WhatsApp
        </a>
        <a href="#menu" class="btn btn-ghost">Ver el menú</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { site, formatTime } from '../data/site';

  // Estado de hoy en hora de Honduras (America/Tegucigalpa)
  const el = document.querySelector<HTMLElement>('[data-open-status]');
  if (el) {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: site.timeZone,
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const dow = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
    const minutes = Number(get('hour')) * 60 + Number(get('minute'));
    const toMin = (t: string) => {
      const [h, m] = t.split(':').map(Number);
      return h * 60 + m;
    };
    const byDow = (d: number) => site.hours.find((h) => h.dow === d)!;
    const today = byDow(dow);
    const text = el.querySelector('[data-text]')!;
    const dot = el.querySelector<HTMLElement>('[data-dot]')!;

    let message: string;
    let open = false;
    if (today.open && today.close && minutes >= toMin(today.open) && minutes < toMin(today.close)) {
      open = true;
      const close = formatTime(today.close);
      message = close === 'medianoche' ? 'Abierto hoy hasta la medianoche' : `Abierto hoy hasta las ${close}`;
    } else if (today.open && minutes < toMin(today.open)) {
      message = `Hoy abrimos a las ${formatTime(today.open)}`;
    } else {
      let next = (dow + 1) % 7;
      while (!byDow(next).open) next = (next + 1) % 7;
      const n = byDow(next);
      message = `Cerrado ahora · abrimos el ${n.day.toLowerCase()} a las ${formatTime(n.open!)}`;
    }
    text.textContent = message;
    dot.classList.toggle('bg-gold', open);
    dot.classList.toggle('bg-rose/60', !open);
  }
</script>
