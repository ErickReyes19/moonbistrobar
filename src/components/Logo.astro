---
// Monograma vectorizado del logo oficial (public/brand/moon-mark.svg) + wordmark en Cinzel.
// ⚠️ Reemplazar por el SVG original del restaurante cuando lo entreguen.
interface Props {
  variant?: 'full' | 'mark' | 'stacked';
  class?: string;
}
const { variant = 'full', class: className = '' } = Astro.props;
---

{
  variant === 'mark' ? (
    <img src="/brand/moon-mark.svg" alt="Moon Bistro Bar" width="42" height="50" class={className} />
  ) : variant === 'stacked' ? (
    <span class:list={['inline-flex flex-col items-center gap-3 text-center', className]}>
      <img src="/brand/moon-mark.svg" alt="" width="84" height="100" class="h-[100px] w-auto" />
      <span class="font-logo text-[1.75rem] leading-none tracking-[0.32em] text-champagne pl-[0.32em]">MOON</span>
      <span class="font-logo text-[0.6875rem] leading-none tracking-[0.42em] text-champagne/80 pl-[0.42em]">
        BISTRO&nbsp;•&nbsp;BAR
      </span>
    </span>
  ) : (
    <span class:list={['inline-flex items-center gap-3', className]}>
      <img src="/brand/moon-mark.svg" alt="" width="34" height="40" class="h-10 w-auto" />
      <span class="flex flex-col leading-none">
        <span class="font-logo text-[1.25rem] tracking-[0.28em] text-champagne">MOON</span>
        <span class="font-logo mt-1 text-[0.5625rem] tracking-[0.38em] text-champagne/80">BISTRO&nbsp;•&nbsp;BAR</span>
      </span>
    </span>
  )
}
